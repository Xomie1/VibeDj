# Free keys from https://api.audius.co/plans (optional, raises rate limits).
# Each key has its own limit (free: 10 req/s, 500k req/month); the app rotates
# through every pair below. Add _4, _5... for more. Keep real values in .env
# only: the bearer token is a secret and .env is git-ignored.
AUDIUS_API_KEY_1=
AUDIUS_BEARER_TOKEN_1=
AUDIUS_API_KEY_2=
AUDIUS_BEARER_TOKEN_2=
AUDIUS_API_KEY_3=
AUDIUS_BEARER_TOKEN_3=
AUDIUS_APP_NAME=vibe-dj
# VIBE_DB_PATH=data/vibe.db
